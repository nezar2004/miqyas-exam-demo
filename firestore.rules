rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function teacher() {
      return request.auth != null
        && exists(/databases/$(database)/documents/teacherRoles/$(request.auth.uid));
    }
    function admin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/adminRoles/$(request.auth.uid));
    }
    match /adminRoles/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if admin();
    }
    // Only the project owner provisions administrators.
    match /teacherRoles/{uid} {
      allow get: if admin() || (request.auth != null && request.auth.uid == uid);
      allow list: if admin();
      allow create: if admin()
        && request.resource.data.keys().hasOnly(['name', 'email'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && !exists(/databases/$(database)/documents/studentProfiles/$(uid))
        && !exists(/databases/$(database)/documents/adminRoles/$(uid));
      allow delete: if admin();
    }
    match /teacherBanks/{uid}/questions/{id} {
      function validQuestion() {
        let q = request.resource.data;
        return q.prompt is string && q.prompt.size() > 0 && q.prompt.size() <= 400
          && q.options is list && q.options.size() >= 2 && q.options.size() <= 10
          && q.correct is int && q.correct >= 0 && q.correct < q.options.size()
          && q.points is int && q.points >= 1 && q.points <= 100;
      }
      allow read: if teacher() && request.auth.uid == uid;
      allow create: if teacher() && request.auth.uid == uid && validQuestion()
        && request.resource.data.keys().hasOnly(['prompt', 'options', 'correct', 'points']);
      allow update: if teacher() && request.auth.uid == uid && validQuestion()
        && request.resource.data.keys().hasOnly(['prompt', 'options', 'correct', 'points', 'originalCorrect', 'originalPoints'])
        && request.resource.data.originalCorrect == resource.data.get('originalCorrect', resource.data.correct)
        && request.resource.data.originalPoints == resource.data.get('originalPoints', resource.data.points);
    }
    match /teacherBanks/{uid}/papers/{id} {
      allow get: if teacher() && request.auth.uid == uid;
      allow create: if teacher() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['ids', 'shuffle'])
        && request.resource.data.ids is list
        && request.resource.data.ids.size() >= 1 && request.resource.data.ids.size() <= 100
        && request.resource.data.shuffle is bool
        && getAfter(/databases/$(database)/documents/publishedExams/$(id)).data.owner == uid
        && getAfter(/databases/$(database)/documents/publishedExams/$(id)).data.questionCount
          == request.resource.data.ids.size();
    }
    match /publishedExams/{id} {
      function validExam() {
        let exam = request.resource.data;
        return exam.keys().hasOnly(['owner', 'title', 'section', 'start', 'duration', 'pass', 'questionCount', 'publishedAt', 'ready'])
          && exam.owner == request.auth.uid
          && exam.title is string && exam.title.size() > 0 && exam.title.size() <= 100
          && exam.section is string && exam.section.size() > 0 && exam.section.size() <= 80
          && exam.start is timestamp
          && exam.duration is int && exam.duration >= 1 && exam.duration <= 180
          && exam.pass is int && exam.pass >= 0 && exam.pass <= 100
          && exam.questionCount is int && exam.questionCount >= 1 && exam.questionCount <= 100
          && exam.publishedAt == request.time;
      }
      allow read: if request.auth != null;
      allow create: if teacher() && validExam()
        && existsAfter(/databases/$(database)/documents/teacherBanks/$(request.auth.uid)/papers/$(id))
        && request.resource.data.ready == true
        && existsAfter(/databases/$(database)/documents/examContent/$(id));
      allow update: if teacher() && resource.data.owner == request.auth.uid
        && request.resource.data.start is timestamp
        && (
          (resource.data.get('ready', false) == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ready', 'start'])
            && request.resource.data.ready == true
            && existsAfter(/databases/$(database)/documents/examContent/$(id)))
          || (resource.data.get('ready', false) == true && !duringExam(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['start'])
            && request.resource.data.start > request.time)
        );
    }
    function duringExam(exam) {
      return exam.get('ready', false) == true && request.time >= exam.start
        && request.time < exam.start + duration.value(exam.duration, 'm');
    }
    function student(uid) {
      return request.auth != null && request.auth.uid == uid && !teacher() && !admin()
        && exists(/databases/$(database)/documents/studentProfiles/$(uid));
    }
    function ownsExam(id) {
      return teacher()
        && get(/databases/$(database)/documents/publishedExams/$(id)).data.owner == request.auth.uid;
    }
    match /examKeys/{id} {
      allow get: if request.auth != null && (ownsExam(id)
        || (student(request.auth.uid)
          && get(/databases/$(database)/documents/studentProfiles/$(request.auth.uid)/attempts/$(id)).data.submittedAt is timestamp));
      allow create: if teacher()
        && getAfter(/databases/$(database)/documents/publishedExams/$(id)).data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['answers'])
        && request.resource.data.answers is map
        && request.resource.data.answers.size() == getAfter(/databases/$(database)/documents/publishedExams/$(id)).data.questionCount;
    }
    match /publishedExams/{id}/participants/{uid} {
      allow read: if ownsExam(id) || (request.auth != null && request.auth.uid == uid);
      allow create: if student(uid)
        && existsAfter(/databases/$(database)/documents/studentProfiles/$(uid)/attempts/$(id))
        && request.resource.data.keys().hasOnly(['name'])
        && request.resource.data.name == get(/databases/$(database)/documents/studentProfiles/$(uid)).data.name;
    }
    match /examContent/{id} {
      function exam() {
        return get(/databases/$(database)/documents/publishedExams/$(id)).data;
      }
      function published() {
        return getAfter(/databases/$(database)/documents/publishedExams/$(id)).data;
      }
      allow get: if request.auth != null &&
        ((teacher() && exam().owner == request.auth.uid)
        || (student(request.auth.uid) && duringExam(exam())));
      allow create: if teacher() && published().owner == request.auth.uid && published().ready == true
        && request.resource.data.keys().hasOnly(['questions', 'shuffle'])
        && request.resource.data.questions is list
        && request.resource.data.questions.size() == published().questionCount
        && request.resource.data.shuffle is bool;
    }
    match /studentProfiles/{uid}/attempts/{id} {
      function exam() {
        return get(/databases/$(database)/documents/publishedExams/$(id)).data;
      }
      allow list: if request.auth != null && request.auth.uid == uid;
      allow get: if request.auth != null && (request.auth.uid == uid || ownsExam(id));
      allow create: if student(uid) && duringExam(exam())
        && request.resource.data.keys().hasOnly(['startedAt','answers','review','submittedAt'])
        && request.resource.data.startedAt == request.time
        && request.resource.data.answers == {} && request.resource.data.review == {}
        && request.resource.data.submittedAt == null;
      allow update: if student(uid) && resource.data.submittedAt == null && (
        (duringExam(exam()) && resource.data.startedAt >= exam().start
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers','review'])
          && request.resource.data.answers is map && request.resource.data.answers.size() <= exam().questionCount
          && request.resource.data.review is map && request.resource.data.review.size() <= exam().questionCount)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['submittedAt'])
          && request.resource.data.submittedAt == request.time)
      );
    }
    // Student profiles contain only a name, the signed-in email, and a creation timestamp.
    match /studentProfiles/{uid} {
      function ownsProfile() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validProfile() {
        let profile = request.resource.data;
        return profile.keys().hasOnly(['name', 'email', 'createdAt'])
          && profile.name is string && profile.name.size() > 0 && profile.name.size() <= 100
          && profile.email is string && profile.email == request.auth.token.email
          && profile.createdAt == request.time;
      }
      allow get: if ownsProfile() || admin();
      allow list: if admin();
      allow create: if ownsProfile() && !teacher() && !admin() && validProfile();
    }
  }
}
