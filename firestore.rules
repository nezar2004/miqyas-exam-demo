rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function teacher() {
      return request.auth != null
        && exists(/databases/$(database)/documents/teacherRoles/$(request.auth.uid))
        && get(/databases/$(database)/documents/teacherRoles/$(request.auth.uid)).data.get('disabled', false) == false;
    }
    function admin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/adminRoles/$(request.auth.uid));
    }
    // A random class ID doubles as its join code. Membership is indexed by class and student.
    function classOwner(id) {
      return get(/databases/$(database)/documents/classes/$(id)).data.owner;
    }
    function managesClass(id) {
      return admin() || (teacher() && classOwner(id) == request.auth.uid);
    }
    function enrolled(id) {
      return exists(/databases/$(database)/documents/classes/$(id)/members/$(request.auth.uid));
    }
    function validClass(data) {
      return data.keys().hasOnly(['owner', 'name', 'subject'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 80;
    }
    match /classes/{id} {
      allow get: if admin() || (teacher() && resource.data.owner == request.auth.uid)
        || (student(request.auth.uid) && enrolled(id));
      allow list: if admin() || (teacher() && resource.data.owner == request.auth.uid);
      allow create: if (admin() || teacher()) && validClass(request.resource.data)
        && request.resource.data.owner is string
        && (request.resource.data.owner == request.auth.uid && teacher()
          || admin() && exists(/databases/$(database)/documents/teacherRoles/$(request.resource.data.owner)));
      allow update: if managesClass(id) && validClass(request.resource.data)
        && request.resource.data.owner == resource.data.owner;
      match /invites/{code} {
        allow list: if managesClass(id);
        allow create: if (admin() || (teacher()
          && getAfter(/databases/$(database)/documents/classes/$(id)).data.owner == request.auth.uid))
          && request.resource.data.keys().size() == 0
          && code.matches('^[A-Za-z0-9]{20}$');
      }
      match /members/{uid} {
        allow list: if managesClass(id);
        allow get: if managesClass(id) || student(uid);
        allow create: if student(uid)
          && exists(/databases/$(database)/documents/classes/$(id))
          && request.resource.data.keys().hasOnly(['name', 'code'])
          && request.resource.data.name == get(/databases/$(database)/documents/studentProfiles/$(uid)).data.name
          && request.resource.data.code is string
          && request.resource.data.code.matches('^[A-Za-z0-9]{20}$')
          && exists(/databases/$(database)/documents/classes/$(id)/invites/$(request.resource.data.code))
          && existsAfter(/databases/$(database)/documents/studentProfiles/$(uid)/classes/$(id));
      }
      match /exams/{examId} {
        allow list: if managesClass(id) || (student(request.auth.uid) && enrolled(id));
        allow create: if teacher() && classOwner(id) == request.auth.uid
          && request.resource.data.keys().size() == 0
          && getAfter(/databases/$(database)/documents/publishedExams/$(examId)).data.owner == request.auth.uid
          && id in getAfter(/databases/$(database)/documents/publishedExams/$(examId)).data.classIds;
        allow delete: if teacher()
          && getAfter(/databases/$(database)/documents/publishedExams/$(examId)).data.owner == request.auth.uid
          && getAfter(/databases/$(database)/documents/publishedExams/$(examId)).data.cancelled == true;
      }
    }
    match /studentProfiles/{uid}/classes/{id} {
      allow read: if student(uid);
      allow create: if student(uid) && request.resource.data.keys().size() == 0
        && existsAfter(/databases/$(database)/documents/classes/$(id)/members/$(uid));
    }
    function classAccess(exam) {
      let ids = exam.get('classIds', []);
      return (ids.size() > 0 && enrolled(ids[0]))
        || (ids.size() > 1 && enrolled(ids[1]))
        || (ids.size() > 2 && enrolled(ids[2]));
    }
    function ownsClassTargets(ids) {
      return ids is list && ids.size() >= 1 && ids.size() <= 3
        && ids.toSet().size() == ids.size()
        && ownsClassTarget(ids[0])
        && (ids.size() < 2 || ownsClassTarget(ids[1]))
        && (ids.size() < 3 || ownsClassTarget(ids[2]));
    }
    function ownsClassTarget(id) {
      return id is string && id.matches('^[A-Za-z0-9]{20}$') && classOwner(id) == request.auth.uid;
    }
    function hasAttempt(id) {
      return exists(/databases/$(database)/documents/studentProfiles/$(request.auth.uid)/attempts/$(id));
    }
    match /adminRoles/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if admin();
    }
    // Only the project owner provisions administrators.
    match /teacherRoles/{uid} {
      allow get: if admin() || (request.auth != null && request.auth.uid == uid);
      allow list: if admin();
      allow create: if admin()
        && request.resource.data.keys().hasOnly(['name', 'email'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && !exists(/databases/$(database)/documents/studentProfiles/$(uid))
        && !exists(/databases/$(database)/documents/adminRoles/$(uid));
      allow delete: if admin();
      allow update: if admin() && validAccountEdit();
    }
    function validAccountEdit() {
      let data = request.resource.data;
      return data.diff(resource.data).affectedKeys().hasOnly(['name', 'disabled'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.get('disabled', false) is bool;
    }
    match /subjects/{id} {
      allow read, delete: if admin();
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['name', 'code'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 80
        && request.resource.data.code is string
        && request.resource.data.code.matches('^[A-Z0-9][A-Z0-9 -]{0,19}$');
    }
    match /auditLog/{id} {
      allow read: if admin();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['actor', 'at', 'action', 'target'])
        && request.resource.data.actor == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.target is string && request.resource.data.target.size() <= 100
        && ((admin() && request.resource.data.action in ['account', 'subject'])
          || (teacher() && request.resource.data.action in ['publish', 'schedule', 'exam', 'cancel']));
    }
    match /teacherBanks/{uid}/questions/{id} {
      function validQuestion() {
        let q = request.resource.data;
        return q.prompt is string && q.prompt.size() > 0 && q.prompt.size() <= 400
          && q.get('subject', '') is string && q.get('subject', '').size() <= 80
          && q.get('topic', '') is string && q.get('topic', '').size() <= 80
          && q.get('difficulty', '') in ['', 'easy', 'medium', 'hard']
          && q.options is list && q.options.size() >= 2 && q.options.size() <= 10
          && q.correct is int && q.correct >= 0 && q.correct < q.options.size()
          && q.points is int && q.points >= 1 && q.points <= 100;
      }
      allow read: if teacher() && request.auth.uid == uid;
      allow create: if teacher() && request.auth.uid == uid && validQuestion()
        && request.resource.data.keys().hasOnly(['prompt', 'options', 'correct', 'points', 'subject', 'topic', 'difficulty']);
      allow update: if teacher() && request.auth.uid == uid && validQuestion()
        && request.resource.data.keys().hasOnly(['prompt', 'options', 'correct', 'points', 'subject', 'topic', 'difficulty', 'originalCorrect', 'originalPoints'])
        && request.resource.data.originalCorrect == resource.data.get('originalCorrect', resource.data.correct)
        && request.resource.data.originalPoints == resource.data.get('originalPoints', resource.data.points);
      allow delete: if teacher() && request.auth.uid == uid;
    }
    match /teacherBanks/{uid}/papers/{id} {
      allow get: if teacher() && request.auth.uid == uid;
      allow create: if teacher() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['ids', 'shuffle'])
        && request.resource.data.ids is list
        && request.resource.data.ids.size() >= 1 && request.resource.data.ids.size() <= 100
        && request.resource.data.shuffle is bool
        && getAfter(/databases/$(database)/documents/publishedExams/$(id)).data.owner == uid
        && getAfter(/databases/$(database)/documents/publishedExams/$(id)).data.questionCount
          == request.resource.data.ids.size();
    }
    match /publishedExams/{id} {
      function validExam() {
        let exam = request.resource.data;
        return exam.keys().hasOnly(['owner', 'title', 'section', 'classIds', 'start', 'duration', 'pass', 'questionCount', 'publishedAt', 'ready'])
          && exam.owner == request.auth.uid
          && ownsClassTargets(exam.classIds)
          && exam.title is string && exam.title.size() >= 3 && exam.title.size() <= 100
          && exam.section is string && exam.section.size() > 0 && exam.section.size() <= 80
          && exam.start is timestamp
          && exam.duration is int && exam.duration >= 1 && exam.duration <= 180
          && exam.pass is int && exam.pass >= 0 && exam.pass <= 100
          && exam.questionCount is int && exam.questionCount >= 1 && exam.questionCount <= 100
          && exam.publishedAt == request.time;
      }
      allow list: if admin() || (teacher() && resource.data.owner == request.auth.uid);
      allow get: if admin() || (teacher() && resource.data.owner == request.auth.uid)
        || (student(request.auth.uid) && ((!resource.data.get('cancelled', false) && classAccess(resource.data)) || hasAttempt(id)));
      allow create: if teacher() && validExam()
        && existsAfter(/databases/$(database)/documents/teacherBanks/$(request.auth.uid)/papers/$(id))
        && request.resource.data.ready == true
        && existsAfter(/databases/$(database)/documents/examContent/$(id));
      allow update: if teacher() && resource.data.owner == request.auth.uid
        && !resource.data.get('cancelled', false) && request.resource.data.start is timestamp
        && (
          (resource.data.get('ready', false) == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ready', 'start'])
            && request.resource.data.ready == true
            && existsAfter(/databases/$(database)/documents/examContent/$(id)))
          || (resource.data.get('ready', false) == true && request.time < resource.data.start
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['start'])
            && request.resource.data.start > request.time)
        );
      allow update: if teacher() && resource.data.owner == request.auth.uid
        && resource.data.get('classIds', []).size() == 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['classIds'])
        && ownsClassTargets(request.resource.data.classIds);
      allow update: if teacher() && resource.data.owner == request.auth.uid
        && request.time < resource.data.start && !resource.data.get('cancelled', false)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'duration', 'pass', 'cancelled'])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 100
        && request.resource.data.duration is int && request.resource.data.duration >= 1 && request.resource.data.duration <= 180
        && request.resource.data.pass is int && request.resource.data.pass >= 0 && request.resource.data.pass <= 100
        && request.resource.data.get('cancelled', false) is bool;
    }
    function duringExam(exam) {
      return exam.get('ready', false) == true && !exam.get('cancelled', false) && request.time >= exam.start
        && request.time < exam.start + duration.value(exam.duration, 'm');
    }
    function verifiedUniversityEmail() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.matches('(?i)^[^@ ]+@ses[.]yu[.]edu[.]jo$');
    }
    function student(uid) {
      return verifiedUniversityEmail() && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/teacherRoles/$(uid)) && !admin()
        && get(/databases/$(database)/documents/studentProfiles/$(uid)).data.get('disabled', false) == false;
    }
    function ownsExam(id) {
      return teacher()
        && get(/databases/$(database)/documents/publishedExams/$(id)).data.owner == request.auth.uid;
    }
    match /examKeys/{id} {
      function canReadStudentKey(uid) {
        let exam = get(/databases/$(database)/documents/publishedExams/$(id)).data;
        return get(/databases/$(database)/documents/studentProfiles/$(uid)/attempts/$(id)).data.submittedAt is timestamp
          && request.time >= exam.start + duration.value(exam.duration + extraMinutes(id, uid), 'm');
      }
      allow get: if request.auth != null && (admin() || ownsExam(id)
        || (student(request.auth.uid) && canReadStudentKey(request.auth.uid)));
      allow create: if teacher()
        && getAfter(/databases/$(database)/documents/publishedExams/$(id)).data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['answers'])
        && request.resource.data.answers is map
        && request.resource.data.answers.size() == getAfter(/databases/$(database)/documents/publishedExams/$(id)).data.questionCount;
    }
    match /publishedExams/{id}/participants/{uid} {
      allow read: if admin() || ownsExam(id) || (request.auth != null && request.auth.uid == uid);
      allow create: if student(uid)
        && existsAfter(/databases/$(database)/documents/studentProfiles/$(uid)/attempts/$(id))
        && request.resource.data.keys().hasOnly(['name'])
        && request.resource.data.name == get(/databases/$(database)/documents/studentProfiles/$(uid)).data.name;
    }
    function extraMinutes(id, uid) {
      let path = /databases/$(database)/documents/publishedExams/$(id)/extensions/$(uid);
      return exists(path) ? get(path).data.minutes : 0;
    }
    function duringStudentExam(exam, id, uid) {
      return exam.ready == true && !exam.get('cancelled', false) && request.time >= exam.start
        && request.time < exam.start + duration.value(exam.duration + extraMinutes(id, uid), 'm');
    }
    match /publishedExams/{id}/extensions/{uid} {
      allow get: if ownsExam(id) || student(uid);
      allow list: if ownsExam(id);
      allow create, update: if ownsExam(id)
        && exists(/databases/$(database)/documents/publishedExams/$(id)/participants/$(uid))
        && get(/databases/$(database)/documents/studentProfiles/$(uid)/attempts/$(id)).data.submittedAt == null
        && request.resource.data.keys().hasOnly(['minutes'])
        && request.resource.data.minutes is int
        && request.resource.data.minutes >= 1 && request.resource.data.minutes <= 120;
    }
    match /examContent/{id} {
      function exam() {
        return get(/databases/$(database)/documents/publishedExams/$(id)).data;
      }
      function published() {
        return getAfter(/databases/$(database)/documents/publishedExams/$(id)).data;
      }
      allow get: if request.auth != null &&
        ((teacher() && exam().owner == request.auth.uid)
        || (student(request.auth.uid) && (
          (duringStudentExam(exam(), id, request.auth.uid) && (classAccess(exam()) || hasAttempt(id)))
          || (request.time >= exam().start + duration.value(exam().duration + extraMinutes(id, request.auth.uid), 'm')
            && get(/databases/$(database)/documents/studentProfiles/$(request.auth.uid)/attempts/$(id)).data.submittedAt is timestamp)
        )));
      allow create: if teacher() && published().owner == request.auth.uid && published().ready == true
        && request.resource.data.keys().hasOnly(['questions', 'shuffle'])
        && request.resource.data.questions is list
        && request.resource.data.questions.size() == published().questionCount
        && request.resource.data.shuffle is bool;
    }
    match /studentProfiles/{uid}/attempts/{id} {
      match /tabEvents/{eventId} {
        allow list: if ownsExam(id);
        allow create: if student(uid)
          && duringStudentExam(get(/databases/$(database)/documents/publishedExams/$(id)).data, id, uid)
          && get(/databases/$(database)/documents/studentProfiles/$(uid)/attempts/$(id)).data.submittedAt == null
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at == request.time;
      }
      function exam() {
        return get(/databases/$(database)/documents/publishedExams/$(id)).data;
      }
      allow list: if student(uid);
      allow get: if admin() || student(uid) || ownsExam(id);
      allow create: if student(uid) && duringExam(exam()) && classAccess(exam())
        && request.resource.data.keys().hasOnly(['startedAt','answers','review','submittedAt'])
        && request.resource.data.startedAt == request.time
        && request.resource.data.answers == {} && request.resource.data.review == {}
        && request.resource.data.submittedAt == null;
      allow update: if student(uid) && resource.data.submittedAt == null && (
        (duringStudentExam(exam(), id, uid) && resource.data.startedAt >= exam().start
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers','review'])
          && request.resource.data.answers is map && request.resource.data.answers.size() <= exam().questionCount
          && request.resource.data.review is map && request.resource.data.review.size() <= exam().questionCount)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['submittedAt'])
          && request.resource.data.submittedAt == request.time)
      );
    }
    // Student profiles contain only a name, the signed-in email, and a creation timestamp.
    match /studentProfiles/{uid} {
      function ownsProfile() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validProfile() {
        let profile = request.resource.data;
        return profile.keys().hasOnly(['name', 'email', 'createdAt'])
          && profile.name is string && profile.name.size() > 0 && profile.name.size() <= 100
          && profile.email is string && profile.email == request.auth.token.email
          && profile.createdAt == request.time;
      }
      allow get: if ownsProfile() || admin();
      allow list: if admin();
      allow create: if ownsProfile() && verifiedUniversityEmail() && !teacher() && !admin() && validProfile();
      allow create: if admin()
        && !exists(/databases/$(database)/documents/teacherRoles/$(uid))
        && !exists(/databases/$(database)/documents/adminRoles/$(uid))
        && request.resource.data.keys().hasOnly(['name', 'email', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.matches('(?i)^[^@ ]+@ses[.]yu[.]edu[.]jo$')
        && request.resource.data.createdAt == request.time;
      allow update: if student(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 100;
      allow update: if admin() && validAccountEdit();
    }
  }
}
