{
  "functions": {"source": "firebase-backend"},
  "hosting": {
    "public": "dist",
    "headers": [
      {
        "source": "**",
        "headers": [
          {"key": "X-Content-Type-Options", "value": "nosniff"},
          {"key": "Content-Security-Policy", "value": "default-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"},
          {"key": "Referrer-Policy", "value": "same-origin"}
        ]
      }
    ],
    "rewrites": [{"source": "/api/**", "function": {"functionId": "miqyasApi", "region": "us-central1"}}]
  }
}
